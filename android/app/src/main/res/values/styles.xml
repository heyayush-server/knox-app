<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
        Knox Launch Theme — shown during cold start before Flutter renders.
        Matches the AMOLED black splash so there's no white flash.
    -->
    <style name="LaunchTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:windowFullscreen">false</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">#FF000000</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
    </style>

    <!--
        Normal Theme — used after Flutter takes over.
        Transparent background so Flutter draws its own AMOLED black.
    -->
    <style name="NormalTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">?android:colorBackground</item>
        <item name="android:windowFullscreen">false</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">#FF000000</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
    </style>

    <!--
        Lock Overlay Theme — for LockOverlayActivity.
        showWhenLocked requires a transparent / translucent window so the
        lock screen can appear over any app.
        Uses Theme.Translucent.NoTitleBar as parent.
    -->
    <style name="LockOverlayTheme" parent="@android:style/Theme.Black.NoTitleBar.Fullscreen">
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:windowIsTranslucent">false</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">#FF000000</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <!-- Keep the lock overlay visible over the keyguard -->
        <item name="android:windowShowWhenLocked">true</item>
    </style>
</resources>
