<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    package="com.knox.applocker">

    <!-- ═══════════════════════════════════════════════════════════════════
         PERMISSIONS
         All permissions are security-justified, no internet permission.
    ═══════════════════════════════════════════════════════════════════ -->

    <!-- Required to detect which app is currently in foreground -->
    <uses-permission android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />

    <!-- Required to draw lock overlay on top of other apps -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <!-- Required to keep Knox guard service alive -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />

    <!-- Required for auto-start on device reboot -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- Biometric permissions -->
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />
    <uses-permission android:name="android.permission.USE_FINGERPRINT" />

    <!-- Required for vibration on unlock -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- Required to query installed packages on Android 11+ -->
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="QueryAllPackagesPermission" />

    <!-- Post notifications for foreground service (Android 13+) -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- ═══════════════════════════════════════════════════════════════════
         FEATURES — Declare fingerprint as optional so app works without it
    ═══════════════════════════════════════════════════════════════════ -->
    <uses-feature
        android:name="android.hardware.fingerprint"
        android:required="false" />

    <application
        android:label="Knox Security"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher"
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:hardwareAccelerated="true"
        android:largeHeap="false"
        android:theme="@style/NormalTheme"
        tools:targetApi="31">

        <!-- ───────────────────────────────────────────────────────────────
             MAIN ACTIVITY
        ─────────────────────────────────────────────────────────────── -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize"
            android:showWhenLocked="false"
            android:turnScreenOn="false">

            <!-- FLAG_SECURE: prevent screenshots of sensitive screens -->
            <!-- This is set programmatically in MainActivity.kt -->

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Deep link for biometric alert (triggered from service) -->
            <intent-filter>
                <action android:name="com.knox.applocker.SECURITY_ALERT" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!-- ───────────────────────────────────────────────────────────────
             LOCK OVERLAY ACTIVITY
             Displayed when a locked app is opened.
             showWhenLocked + turnScreenOn ensures it appears over lockscreen.
        ─────────────────────────────────────────────────────────────── -->
        <activity
            android:name=".LockOverlayActivity"
            android:exported="false"
            android:launchMode="singleTask"
            android:theme="@style/LockOverlayTheme"
            android:excludeFromRecents="true"
            android:showWhenLocked="true"
            android:turnScreenOn="true"
            android:screenOrientation="portrait"
            android:configChanges="orientation|screenSize"
            android:windowSoftInputMode="adjustResize" />

        <!-- ───────────────────────────────────────────────────────────────
             KNOX ACCESSIBILITY SERVICE
             Core mechanism: monitors foreground app changes via
             TYPE_WINDOW_STATE_CHANGED events to trigger lock screen.

             Samsung OneUI note: Samsung may restrict accessibility services.
             User must manually enable in Settings > Accessibility > Knox.
        ─────────────────────────────────────────────────────────────── -->
        <service
            android:name=".KnoxAccessibilityService"
            android:exported="false"
            android:label="Knox App Guard"
            android:description="@string/accessibility_description"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>

        <!-- ───────────────────────────────────────────────────────────────
             KNOX GUARD FOREGROUND SERVICE
             Keeps Knox alive in background.
             Android 13/14: foregroundServiceType required.
        ─────────────────────────────────────────────────────────────── -->
        <service
            android:name=".KnoxGuardService"
            android:exported="false"
            android:foregroundServiceType="specialUse"
            android:label="Knox Guard">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="App lock guard service" />
        </service>

        <!-- ───────────────────────────────────────────────────────────────
             BOOT RECEIVER
             Auto-starts Knox Guard service when device boots.
        ─────────────────────────────────────────────────────────────── -->
        <receiver
            android:name=".BootReceiver"
            android:exported="true"
            android:enabled="true">
            <intent-filter android:priority="999">
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
                <!-- HTC/Samsung quick boot -->
                <action android:name="com.htc.intent.action.QUICKBOOT_POWERON" />
            </intent-filter>
        </receiver>

        <!-- ───────────────────────────────────────────────────────────────
             NOTIFICATION CHANNEL META
        ─────────────────────────────────────────────────────────────── -->
        <meta-data
            android:name="com.knox.notification_channel_id"
            android:value="knox_guard_channel" />

    </application>

    <uses-sdk tools:overrideLibrary="io.flutter.plugins.localauth" />

</manifest>
